{
  "schemaVersion": 1,
  "id": "io.github.twiking.omasettings",
  "name": "OmaSettings",
  "version": "1.1.3",
  "author": "Tobias Wiking",
  "license": "MIT",
  "description": "One window for every Omarchy setting, from Hyprland to your keybindings to tmux. Searchable, and anything you change can be put back.",
  "homepage": "https://github.com/twiking/omasettings",
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "OmaSettings",
    "description": "Opens the OmaSettings window.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
